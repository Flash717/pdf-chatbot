EMBED_MODEL=nomic-embed-text
CHAT_MODEL=llama3.1

PDF_DIR=../data/pdfs
CHROMA_DIR=../chroma_db
COLLECTION_NAME=pdf_docs

CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=5
EMBED_BATCH_SIZE=32

BM25_INDEX_PATH=../bm25_index.pkl
